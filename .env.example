# Copy to .env.local (local) or set in your hosting provider's environment settings.
# All values are optional; the site works without them.

# Live domain, used for canonical URLs, sitemap, structured data and social cards.
NEXT_PUBLIC_SITE_URL=https://vsmedico.in

# Sanity content management (see SANITY-SETUP.txt). Create a project at https://sanity.io/manage.
# Website build: reads published content from Sanity before generating the static pages.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Studio (npm run studio / npm run studio:deploy): same values, under the names the Studio can read.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional: Viewer token, only needed if the dataset is private. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Local only, for the one-time `npm run sanity:import`: Editor token. Do not add it to hosting.
SANITY_API_WRITE_TOKEN=

# Email delivery for the contact, quote and account-registration forms.
# Get a free access key at https://web3forms.com (enter the sales inbox email).
# Without it, forms fall back to sending the inquiry via WhatsApp.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Search engine ownership verification (Google Search Console / Bing Webmaster Tools, HTML-tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
